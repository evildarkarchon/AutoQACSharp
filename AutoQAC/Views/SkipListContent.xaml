<UserControl
    x:Class="AutoQAC.Views.SkipListContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:AutoQAC.Models">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" MinWidth="620" MaxHeight="620">
        <Grid Grid.Row="0" ColumnDefinitions="120,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="Game:" VerticalAlignment="Center" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding AvailableGames, Mode=OneWay}"
                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:GameType">
                        <TextBlock Text="{Binding Converter={StaticResource GameTypeDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Available Plugins" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{Binding AvailablePlugins, Mode=OneWay}"
                          SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <Button Content="Add >" Command="{Binding AddSelectedPluginCommand}" MinWidth="96" />
                <Button Content="&lt; Remove" Command="{Binding RemoveSelectedEntryCommand}" MinWidth="96" />
            </StackPanel>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Skip List Entries" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView ItemsSource="{Binding SkipListEntries, Mode=OneWay}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox
                Grid.Column="0"
                Header="Manual entry"
                Text="{Binding ManualEntryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="PluginName.esp" />
            <Button Grid.Column="1" Content="Add" Command="{Binding AddManualEntryCommand}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                Text="{Binding ManualEntryError, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="{Binding ManualEntryError, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

