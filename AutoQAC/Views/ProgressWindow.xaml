<Window
    x:Class="AutoQAC.Views.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cleaning Progress">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid
            Visibility="{Binding IsShowingResults, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
            RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Current phase:" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ActiveOperationLabel, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{Binding HasCurrentPluginStats, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="ITM:" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding CurrentItmCount, Mode=OneWay}" />
                    <TextBlock Text="UDR:" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding CurrentUdrCount, Mode=OneWay}" />
                    <TextBlock Text="Nav:" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding CurrentNavCount, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                IsOpen="{Binding IsHangWarningVisible, Mode=OneWay}"
                Severity="Warning"
                Title="xEdit may be hung"
                Message="The current xEdit process appears inactive. You can wait, dismiss this warning, or force-stop the process.">
                <InfoBar.ActionButton>
                    <Button Content="Force Stop" Command="{Binding KillHungProcessCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                Grid.Row="2"
                IsOpen="{Binding IsBackupOperationActive, Mode=OneWay}"
                Severity="Informational"
                Title="{Binding ActiveOperationLabel, Mode=OneWay}"
                Message="{Binding BackupOperationProgressText, Mode=OneWay}" />

            <StackPanel Grid.Row="3" Spacing="8">
                <ProgressBar Minimum="0" Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" />
                <TextBlock Text="{Binding ProgressText, Mode=OneWay}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CurrentPlugin, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView Grid.Row="4" ItemsSource="{Binding CompletedPlugins, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,*" ColumnSpacing="12" Padding="4">
                            <TextBlock Grid.Column="0" Text="{Binding PluginName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding ItemsRemoved}" />
                            <TextBlock Grid.Column="2" Text="{Binding ItemsUndeleted}" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" />
                            <TextBlock Grid.Column="4" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel File Operation" Command="{Binding CancelBackupOperationCommand}"
                        Visibility="{Binding IsBackupCancelVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <Button Content="Cancel Cleanup" Command="{Binding CancelBackupOperationCommand}"
                        Visibility="{Binding IsCleanupCancelVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsCleaning, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid
            Visibility="{Binding IsResultsSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
            RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Text="{Binding SessionSummaryText, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar
                Grid.Row="1"
                IsOpen="{Binding HasStopOutcomeWarning, Mode=OneWay}"
                Severity="Warning"
                Message="{Binding StopOutcomeWarningText, Mode=OneWay}" />
            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding CleanedCount, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{Binding SkippedCount, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding FailedCount, Mode=OneWay}" />
                    <TextBlock Grid.Column="3" Text="{Binding TotalItmCount, Mode=OneWay}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding CompletedPlugins, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,Auto,Auto,*" ColumnSpacing="12" Padding="4">
                                <TextBlock Grid.Column="0" Text="{Binding PluginName}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                <TextBlock Grid.Column="2" Text="{Binding ItemsRemoved}" />
                                <TextBlock Grid.Column="3" Text="{Binding Summary}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Button Grid.Row="3" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
        </Grid>

        <Grid Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
              RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Text="Dry-Run Preview" Style="{StaticResource SubtitleTextBlockStyle}" />
            <InfoBar Grid.Row="1" IsOpen="True" Severity="Informational"
                     Message="{Binding PreviewDisclaimer, Mode=OneWay}" />
            <ListView Grid.Row="2" ItemsSource="{Binding DryRunResults, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*,Auto,*" ColumnSpacing="12" Padding="4">
                            <TextBlock Grid.Column="0" Text="{Binding PluginName}" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" />
                            <TextBlock Grid.Column="2" Text="{Binding Reason}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="3" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>

