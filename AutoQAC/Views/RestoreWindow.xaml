<Window
    x:Class="AutoQAC.Views.RestoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Restore Backups">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12" RowDefinitions="*,Auto,Auto" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="260,*" ColumnSpacing="12">
            <Grid Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Backup Sessions" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,8" />
                <ListView Grid.Row="1" Margin="6" ItemsSource="{Binding Sessions, Mode=OneWay}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding Plugins.Count}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Session Details" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,8" />
                <ListView Grid.Row="1" Margin="6" ItemsSource="{Binding SelectedSessionPlugins, Mode=OneWay}" SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="4">
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" />
                                <TextBlock Grid.Column="1" Text="{Binding FileSizeBytes}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{Binding IsRestoreActive, Mode=OneWay}" Severity="Informational" Title="Restore in progress" Message="{Binding RestoreProgressText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Cancel Restore" Command="{Binding CancelRestoreCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{Binding IsRestoreResultVisible, Mode=OneWay}" Severity="Informational" Title="{Binding RestoreOutcomeTitle, Mode=OneWay}" Message="{Binding RestoreSummaryText, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Delete Session" Command="{Binding DeleteSessionCommand}" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadSessionsCommand}" />
            <Button Grid.Column="3" Content="Restore Selected" Command="{Binding RestorePluginCommand}" />
            <Button Grid.Column="4" Content="Restore All" Command="{Binding RestoreAllCommand}" />
            <Button Grid.Column="5" Content="Close" Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
