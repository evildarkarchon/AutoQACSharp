<Application
    x:Class="AutoQAC.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:AutoQAC.Views.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <helpers:GameTypeDisplayConverter x:Key="GameTypeDisplayConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <helpers:NullableTrueToVisibilityConverter x:Key="NullableTrueToVisibilityConverter" />
            <helpers:NullableFalseToVisibilityConverter x:Key="NullableFalseToVisibilityConverter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <helpers:IntDoubleConverter x:Key="IntDoubleConverter" />
            <Style x:Key="AutoQACHyperlinkButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
